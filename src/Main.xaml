<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HDLSS 1.0.0 · Portable" Width="1450" Height="920" MinWidth="1180" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#0C0F13" Foreground="#F0F3F5" FontFamily="Cascadia Mono, Consolas" FontSize="14" WindowStyle="None" ResizeMode="CanResize">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
 </shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style TargetType="Slider">
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Slider">
      <Grid Height="32" Margin="8,0">
       <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#E6AC50" CornerRadius="2" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb Width="18" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#E6AC50" Stroke="#FFE3AC" StrokeThickness="2" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#3D4856" CornerRadius="2" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
       </Track>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <SolidColorBrush x:Key="Muted" Color="#919BAA" />
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#BAC4D0" />
   <Setter Property="Background" Value="#232A34" />
   <Setter Property="BorderBrush" Value="#35404D" />
   <Setter Property="Padding" Value="12,8" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="B" Property="BorderBrush" Value="#E6AC50" />
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.4" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="Installed" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#E6AC50" />
   <Setter Property="Foreground" Value="#201B08" />
   <Setter Property="BorderBrush" Value="#E6AC50" />
   <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#435D75" />
   <Setter Property="Foreground" Value="#FFFFFF" />
   <Setter Property="BorderBrush" Value="#435D75" />
   <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="RestoreAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Foreground" Value="#E2AD8F" />
   <Setter Property="BorderBrush" Value="#674E41" />
  </Style>
  <Style x:Key="InfoAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Foreground" Value="#A9C3DC" />
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#0D1118" />
   <Setter Property="Foreground" Value="#F1F4F7" />
   <Setter Property="CaretBrush" Value="#E6AC50" />
   <Setter Property="BorderBrush" Value="#364150" />
   <Setter Property="Padding" Value="10,9" />
   <Setter Property="VerticalContentAlignment" Value="Center" />
   <Setter Property="SelectionBrush" Value="#655722" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="TextBox">
      <Border x:Name="InputEdge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
       <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="InputEdge" Property="BorderBrush" Value="#E6AC50" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#F0F3F5" />
   <Setter Property="Background" Value="#202833" />
   <Setter Property="Padding" Value="9" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid>
       <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="#202833" BorderBrush="#364150">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
           <TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#E6AC50" />
          </Border>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>
       <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="10,8,28,8" IsHitTestVisible="False" />
       <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
        <Border Background="#202833" BorderBrush="#465367" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
         <ScrollViewer MaxHeight="240">
          <ItemsPresenter />
         </ScrollViewer>
        </Border>
       </Popup>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#F0F3F5" />
   <Setter Property="Padding" Value="10" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Item" Background="#202833" Padding="{TemplateBinding Padding}">
       <ContentPresenter />
      </Border>
      <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
       <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Item" Property="Background" Value="#514828" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ToolTip">
   <Setter Property="Background" Value="#242D39" />
   <Setter Property="Foreground" Value="White" />
  </Style>
  <Style x:Key="Card" TargetType="ListBoxItem">
   <Setter Property="Padding" Value="0" />
   <Setter Property="Margin" Value="0,0,16,20" />
   <Setter Property="HorizontalContentAlignment" Value="Stretch" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Edge" Background="#171D26" BorderBrush="#293340" BorderThickness="2" CornerRadius="10" Padding="5">
       <ContentPresenter />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="Edge" Property="BorderBrush" Value="#E6AC50" />
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Edge" Property="Background" Value="#252F3C" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#BBC4D0" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="VerticalContentAlignment" Value="Center" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="CheckBox">
      <Grid Background="Transparent">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="38" />
        <ColumnDefinition Width="*" />
       </Grid.ColumnDefinitions>
       <Border x:Name="Rail" Width="34" Height="19" CornerRadius="10" Background="#39414D" BorderBrush="#536071" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Ellipse x:Name="Knob" Width="13" Height="13" Fill="#D9E0E8" HorizontalAlignment="Left" Margin="2,0,0,0" />
       </Border>
       <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Rail" Property="Background" Value="#E6AC50" />
        <Setter TargetName="Rail" Property="BorderBrush" Value="#E6AC50" />
        <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
        <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
        <Setter TargetName="Knob" Property="Fill" Value="#231B0C" />
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Rail" Property="BorderBrush" Value="White" />
        <Setter TargetName="Rail" Property="BorderThickness" Value="2" />
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.4" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="Expander">
   <Setter Property="Foreground" Value="#BBC4D0" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Expander">
      <StackPanel>
       <ToggleButton IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}" Padding="0,8">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <Border Padding="{TemplateBinding Padding}" Background="Transparent">
           <DockPanel>
            <TextBlock x:Name="Arrow" Text="›" Foreground="#E6AC50" FontSize="17" Width="20" />
            <ContentPresenter VerticalAlignment="Center" />
           </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Arrow" Property="Text" Value="⌄" />
           </Trigger>
           <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter Property="Foreground" Value="#E6AC50" />
           </Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate>
        </ToggleButton.Template>
        <ContentPresenter Content="{TemplateBinding Header}" />
       </ToggleButton>
       <ContentPresenter x:Name="Body" ContentSource="Content" Visibility="Collapsed" />
      </StackPanel>
      <ControlTemplate.Triggers>
       <Trigger Property="IsExpanded" Value="True">
        <Setter TargetName="Body" Property="Visibility" Value="Visible" />
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="9" />
   <Setter Property="Background" Value="#141A22" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ScrollBar">
      <Border Background="{TemplateBinding Background}">
       <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
        <Track.DecreaseRepeatButton>
         <RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand">
          <RepeatButton.Template>
           <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
           </ControlTemplate>
          </RepeatButton.Template>
         </RepeatButton>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
         <Thumb>
          <Thumb.Template>
           <ControlTemplate TargetType="Thumb">
            <Border x:Name="ThumbBody" Background="#424C59" CornerRadius="4" Margin="2" />
            <ControlTemplate.Triggers>
             <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbBody" Property="Background" Value="#E6AC50" />
             </Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate>
          </Thumb.Template>
         </Thumb>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
         <RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand">
          <RepeatButton.Template>
           <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
           </ControlTemplate>
          </RepeatButton.Template>
         </RepeatButton>
        </Track.IncreaseRepeatButton>
       </Track>
      </Border>
     <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" /><Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand" /><Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand" /></Trigger></ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="14" /></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Border BorderBrush="#303844" BorderThickness="1">
  <Grid ClipToBounds="True">
   <Grid.RowDefinitions>
    <RowDefinition Height="38" />
    <RowDefinition Height="*" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="76" />
   </Grid.RowDefinitions>
   <Border Background="#11161D" BorderBrush="#27313C" BorderThickness="0,0,0,1">
    <DockPanel>
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Button x:Name="MinimizeWindow" Content="−" Width="44" Padding="0" BorderThickness="0" ToolTip="Riduci a icona" />
      <Button x:Name="MaximizeWindow" Content="□" Width="44" Padding="0" ToolTip="Ingrandisci / ripristina" />
      <Button x:Name="CloseWindow" Content="×" Width="48" Padding="0" ToolTip="Chiudi" />
     </StackPanel>
     <TextBlock Text="H  /  HDLSS  1.0.0" Foreground="#E6AC50" VerticalAlignment="Center" Margin="18,0" FontSize="12" />
    </DockPanel>
   </Border>
   <Grid Grid.Row="1">
    <Grid.RowDefinitions><RowDefinition x:Name="LibraryRow" Height="370" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="210" />
     <ColumnDefinition Width="*" />

    </Grid.ColumnDefinitions>
    <Border Grid.RowSpan="3" Background="#11161D" BorderBrush="#26303B" BorderThickness="0,0,1,0">
     <Border.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="NoWrap" TextAlignment="Center" /></DataTemplate></Setter.Value></Setter></Style></Border.Resources>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="20,26">
      <StackPanel DockPanel.Dock="Top">
       <Image x:Name="BrandLogo" Height="66" Stretch="Uniform" HorizontalAlignment="Stretch" Margin="-8,0,-8,6" RenderOptions.BitmapScalingMode="HighQuality" />
       <TextBlock Text="PORTABLE / 1.0.0" FontSize="11" Foreground="{StaticResource Muted}" />
       <Button x:Name="Home" Content="Library" Margin="0,32,0,0" />
       <TextBlock Text="HDR + DLSS" FontSize="11" Foreground="{StaticResource Muted}" Margin="4,22,0,5" />
       <TextBlock Text="HDR, DLSS e mod grafiche. Senza complicazioni." TextWrapping="Wrap" FontSize="12" Foreground="#BAC4D0" Margin="4,0,0,0" />
      </StackPanel>
      <StackPanel Margin="0,24,0,0">


       <Button x:Name="OverlayDiagnostic" Content="Diagnostics" FontSize="14" Margin="0,0,0,10" />

       <Button x:Name="Help" Content="Help" Margin="0,0,0,10" />
       <Button x:Name="DataFolder" Content="Backups" Margin="0,0,0,18" />
       <TextBlock x:Name="MonitorLabel" Text="Monitor" TextWrapping="Wrap" Foreground="#E5EDF5" FontWeight="SemiBold" />
       <TextBlock Text="Profilo del display selezionato" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0" />
      </StackPanel>
     </StackPanel></ScrollViewer>
    </Border>
    <Grid x:Name="LibrarySection" Grid.Column="1" Margin="24,12,24,0">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
     </Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
       <TextBlock Text="Language" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
       <ComboBox x:Name="HomeLanguage" Width="125" Margin="0,0,12,0" />
       <ComboBox x:Name="HomeTheme" Width="115" ToolTip="Appearance" />
      </StackPanel>
      <TextBlock x:Name="Count" Visibility="Collapsed" DockPanel.Dock="Right" Foreground="#919BAA" FontSize="12" VerticalAlignment="Center" />
      <TextBlock Text="LA TUA LIBRERIA" FontSize="20" Foreground="#E6AC50" FontWeight="SemiBold" />
     </DockPanel>
     <DockPanel Grid.Row="1" Margin="0,0,0,10">
      <Button x:Name="CoverButton" DockPanel.Dock="Right" Content="Cover" IsEnabled="False" Margin="8,0,0,0" />
      <Button x:Name="AddGame" DockPanel.Dock="Right" Content="Add game" Margin="8,0,0,0" />
      <Button x:Name="SteamFolder" DockPanel.Dock="Right" Content="Libreria…" Margin="8,0,0,0" />
      <Button x:Name="Scan" DockPanel.Dock="Right" Content="↻ Scansiona" Margin="8,0,0,0" />
      <CheckBox x:Name="ShowUncertain" DockPanel.Dock="Right" IsChecked="True" Content="Tutti i giochi" VerticalAlignment="Center" Margin="12,0,4,0" />
      <TextBox x:Name="Search" ToolTip="Cerca nella libreria" />
     </DockPanel>
     <Grid Grid.Row="2" ClipToBounds="True">
      <Image x:Name="GameBackdrop" Visibility="Collapsed" IsHitTestVisible="False" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch" VerticalAlignment="Center" Opacity="1" RenderOptions.BitmapScalingMode="HighQuality" />
      <Border IsHitTestVisible="False" Background="{Binding Background,RelativeSource={RelativeSource AncestorType=Window}}" Opacity="0.12" />
      <ListBox x:Name="Games" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource Card}">
       <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
         <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
       </ListBox.ItemsPanel>
       <ListBox.ItemTemplate>
        <DataTemplate>
         <StackPanel Width="{DynamicResource LibraryCardWidth}">
          <Grid Height="{DynamicResource LibraryPosterHeight}" Background="#242D3A" ClipToBounds="True">
           <Rectangle RenderOptions.BitmapScalingMode="HighQuality"><Rectangle.Fill><ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" /></Rectangle.Fill></Rectangle>
           <Border Background="#DA11171E" VerticalAlignment="Bottom" Padding="7">
            <TextBlock Text="{Binding ArtworkLabel}" Foreground="#E6AC50" FontSize="11" />
           </Border>
          </Grid>
          <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MinHeight="45" FontWeight="SemiBold" Margin="7,9,7,0" Foreground="#F0F3F5" />
          <TextBlock Visibility="Collapsed" Text="{Binding ConfigLabel}" Foreground="#939FAE" FontSize="11" Margin="7,5,7,8" />
         </StackPanel>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="Empty" Text="Nessun gioco corrispondente.&#10;Scansiona Steam e Xbox / Game Pass o aggiungi una cartella." TextAlignment="Center" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Visibility="Collapsed" />
     </Grid>
     <Border Visibility="Collapsed" Grid.Row="3" BorderBrush="#293340" BorderThickness="0,1,0,0" Padding="0,12,0,0">
      <TextBlock x:Name="Status" Text="Pronto." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" />
     </Border>
    </Grid>
    <DockPanel Grid.Column="1" Grid.Row="1" Margin="24,8,24,10">
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,18,0">
      <Button x:Name="Overview" Content="Back" Visibility="Collapsed" Width="115" />
     </StackPanel>
     <Button x:Name="InjectionSetup" Content="Eseguibile e grafica…" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" IsEnabled="False" />
     <StackPanel><TextBlock Text="ESEGUIBILE DEL GIOCO · dove verranno installati i componenti" FontSize="11" Foreground="#E6AC50" Margin="0,0,0,3" />
      <TextBox x:Name="TargetPath" Text="Seleziona un gioco" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" Padding="7,5" /></StackPanel>
    </DockPanel>
    <ScrollViewer x:Name="FeatureHome" Grid.Column="1" Grid.Row="2" Margin="24,0,24,0" VerticalScrollBarVisibility="Auto">
     <Grid Margin="0,4,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <Border Background="#151D26" BorderBrush="#303E4B" BorderThickness="1" CornerRadius="10" Padding="20">
       <StackPanel>
        <DockPanel><Button x:Name="HdrSection" Content="Set up HDR" Style="{StaticResource Primary}" DockPanel.Dock="Right" Margin="12,0,0,0" Padding="18,10" IsEnabled="False" /><TextBlock Text="HDR" FontSize="25" Foreground="#E6AC50" FontWeight="SemiBold" /></DockPanel><TextBlock x:Name="HdrCardStatus" Text="Select a game" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Foreground="#ADBACA" />
        <TextBlock Text="Better highlights. Clearer dark scenes." Foreground="#ADBACA" FontSize="13" Margin="0,5,0,14" TextWrapping="Wrap" />
        <TextBlock x:Name="HdrCardMethod" Text="Choose a game to see available HDR methods." TextWrapping="Wrap" Margin="0,0,0,12" />
        <Border Background="#202A35" CornerRadius="6" Padding="12" Margin="0,0,0,14">
         <DockPanel><Button x:Name="Hotkey" DockPanel.Dock="Right" Content="Change key" Margin="10,0,0,0" /><StackPanel><TextBlock Text="HDLSS overlay" FontSize="13" /><TextBlock x:Name="HotkeyState" Text="Ctrl + Shift + H" Foreground="#E6AC50" FontSize="12" /></StackPanel></DockPanel>
        </Border>
        
       </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="#151D26" BorderBrush="#303E4B" BorderThickness="1" CornerRadius="10" Padding="20">
       <StackPanel>
        <DockPanel><Button x:Name="Dlss" Content="Set up DLSS 5" Style="{StaticResource Primary}" DockPanel.Dock="Right" Margin="12,0,0,0" Padding="18,10" IsEnabled="False" /><TextBlock Text="DLSS 5" FontSize="25" Foreground="#E6AC50" FontWeight="SemiBold" /></DockPanel><TextBlock x:Name="DlssCardStatus" Text="Select a game" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Foreground="#ADBACA" />
        <TextBlock Text="Neural Rendering through OptiScaler." Foreground="#ADBACA" FontSize="13" Margin="0,5,0,14" TextWrapping="Wrap" />
        <TextBlock x:Name="DlssCardMethod" Text="Choose a game to check its components." TextWrapping="Wrap" Margin="0,0,0,12" />
        <Border Background="#202A35" CornerRadius="6" Padding="12" Margin="0,0,0,14"><TextBlock Text="Choose the build and picture settings. Existing frame generation is preserved by default." TextWrapping="Wrap" FontSize="13" Foreground="#ADBACA" /></Border>
        
       </StackPanel>
      </Border>
     </Grid>
    </ScrollViewer>
    <Border x:Name="HdrSettings" Visibility="Collapsed" Grid.Column="1" Grid.Row="2" Margin="24,0,24,0" Background="#141A22" BorderBrush="#2A3541" BorderThickness="1,0,0,0">
     <ScrollViewer x:Name="HdrScroll" VerticalScrollBarVisibility="Auto">
<StackPanel Margin="18,16">
       <DockPanel Margin="0,0,0,14"><Button x:Name="HdrOverlayKey" DockPanel.Dock="Right" Content="HDR overlay key" /><TextBlock Text="HDR" FontSize="24" Foreground="#E6AC50" /></DockPanel>
       <Border CornerRadius="9" Background="#232D3B" Height="72" Visibility="Collapsed" Margin="0,10,0,8" ClipToBounds="True">
        <Image x:Name="Hero" Stretch="UniformToFill" />
       </Border>
       <TextBlock x:Name="GameTitle" Text="Seleziona un gioco" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
       <TextBlock Text="Come vuoi attivare HDR?" Foreground="#E6AC50" Margin="0,4,0,8" />
       <ComboBox x:Name="HdrMethod" SelectedIndex="0" Margin="0,0,0,12"><ComboBoxItem Content="HDR del motore · UE5" ToolTip="Disponibile solo per i giochi UE5 riconosciuti; effetto HDR da verificare per gioco." /><ComboBoxItem Content="ReShade + RenoDX" /></ComboBox>
       <TextBlock x:Name="HdrMethodInfo" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,12" Foreground="#ADBACA" />
       <Button x:Name="RenoDx" Content="Configura ReShade / RenoDX…" Margin="0,0,0,12" Foreground="#E6AC50" IsEnabled="False" Visibility="Collapsed" />
<Grid x:Name="RenoInline" Visibility="Collapsed" />
<Grid x:Name="UeSettingsGrid"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>      <StackPanel Margin="0,0,24,0">
       <TextBlock x:Name="EngineInfo" Text="I parametri vengono salvati per il titolo selezionato." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,14" />

       <StackPanel Margin="0,4,0,6"><TextBlock Text="Cartella e configurazione" Foreground="#E6AC50" FontSize="14" Margin="0,8,0,8" />
        <Border Background="#1C2631" CornerRadius="8" Padding="12" Margin="0,4,0,6">
         <StackPanel>
          <Button x:Name="OpenGame" Content="Cartella gioco" IsEnabled="False" Margin="0,0,0,8" />
          <TextBlock Text="CONFIGURAZIONE" Foreground="#8E9CAB" FontSize="11" />
          <TextBlock x:Name="ConfigInfo" Text="Nessuna cartella selezionata" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,8" />
          <Button x:Name="ChooseConfig" Content="Scegli cartella impostazioni…" Padding="8,6" IsEnabled="False" />
          <ComboBox x:Name="Sections" Margin="0,8,0,0" ToolTip="Sezione GameUserSettings da modificare" />
         </StackPanel>
        </Border>
       </StackPanel>
       <Border Background="#1C2631" CornerRadius="8" Padding="10" Margin="0,0,0,10">
        <StackPanel>
         <TextBlock Text="MONITOR E CONSIGLI" Foreground="#E6AC50" FontSize="11" />
         <ComboBox x:Name="Monitors" Margin="0,8,0,8" />
         <ComboBox x:Name="MonitorMode" Margin="0,0,0,8" />
         <StackPanel Margin="0,0,0,0"><TextBlock Text="Consigli del monitor" Foreground="#E6AC50" FontSize="14" Margin="0,8,0,8" />
          <StackPanel>
           <TextBlock x:Name="MonitorAdvice" TextWrapping="Wrap" Foreground="#ADBACA" FontSize="12" />
           <Button x:Name="RefreshMonitors" Content="Rileva di nuovo" Padding="8,5" Margin="0,10,0,0" />
          </StackPanel>
         </StackPanel>
        </StackPanel>
       </Border>

       <TextBlock x:Name="ReadState" Text="Valori iniziali, non una calibrazione misurata." TextWrapping="Wrap" FontSize="11" Foreground="#A8B4C2" Margin="0,12,0,10" />
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*" />
         <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="Restore" Content="Ripristina" IsEnabled="False" Margin="0,0,4,0" />
        <Button x:Name="Verify" Grid.Column="1" Content="Verifica file" IsEnabled="False" Margin="4,0,0,0" />
       </Grid>
       <StackPanel Margin="0,8,0,0"><TextBlock Text="Strumenti e parametri motore" Foreground="#E6AC50" FontSize="14" Margin="0,8,0,8" />
        <Border Background="#2B281B" CornerRadius="8" Padding="12" Margin="0,4,0,6">
         <StackPanel>
          <TextBlock Text="PARAMETRI MOTORE · OPZIONALE" Foreground="#E6AC50" FontSize="12" FontWeight="SemiBold" />
          <TextBlock Text="Opzionale: legge i parametri del motore, non la scena. L’analizzatore di luminanza usa Windows e non richiede UE4SS." TextWrapping="Wrap" Foreground="#C3BDA6" FontSize="12" Margin="0,7,0,10" />
          <TextBlock x:Name="ReaderStatus" Text="Seleziona un gioco per verificare il lettore." TextWrapping="Wrap" Foreground="#C3BDA6" FontSize="12" Margin="0,0,0,10" /><Button x:Name="RefreshReader" Content="Aggiorna stato lettore" Margin="0,0,0,8" />
          <Button x:Name="EngineOverlay" Content="Vedi parametri del motore" IsEnabled="False" Padding="8,7" Margin="0,0,0,7" />
          <Button x:Name="InstallReader" Content="Installa / attiva lettore UE4SS" IsEnabled="False" Padding="8,7" />
          <Button x:Name="DisableReader" Content="Disattiva lettore" IsEnabled="False" Margin="0,6,0,0" Padding="8,5" />
         </StackPanel>
        </Border>
       </StackPanel>
       
       <TextBlock Text="Sola lettura ripristinata dopo il salvataggio.&#10;La verifica dei file non misura l’HDR in gioco." Foreground="#758496" FontSize="11" TextWrapping="Wrap" Margin="0,13,0,0" />
      </StackPanel>
       <StackPanel x:Name="UeHdrControls" Grid.Column="1">
       <Grid Margin="0,0,0,7">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*" />
         <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="REGOLAZIONI HDR" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button x:Name="Defaults" Content="Consigliati" Grid.Column="1" Padding="9,5" />
       </Grid>
       <Grid Margin="0,5">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*" />
         <ColumnDefinition Width="82" />
         <ColumnDefinition Width="32" />
        </Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="Picco luminoso" />
         <TextBlock x:Name="PeakAdvice" Text="Consiglio: scegli un monitor" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />
        </StackPanel>
        <TextBox x:Name="Peak" Grid.Column="1" Text="1060" MaxLength="5" TextAlignment="Right" Padding="8,6" />
        <Button Grid.Column="2" Content="?" Padding="0" Width="25" Height="25" Margin="7,0,0,0" x:Name="HelpPeak" Tag="Il limite richiesto alla curva HDR del gioco, in nit. Non aumenta le capacità fisiche del display e non misura i pixel della scena. Usa il valore calibrato per la modalità HDR attiva sul monitor. Valori troppo alti possono perdere dettaglio nelle luci; troppo bassi possono comprimerle. Intervallo: 200–10000. Per AW3423DW: 1000 nominali in Peak 1000; 1060 è la personalizzazione scelta da te, non una misura del tuo pannello." ToolTip="Spiegazione e valori consigliati" />
       </Grid>
       <Grid Margin="0,5">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*" />
         <ColumnDefinition Width="82" />
         <ColumnDefinition Width="32" />
        </Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="Mezzitoni" />
         <TextBlock Text="Base Unreal: 15 nit · grigio 18%" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />
        </StackPanel>
        <TextBox x:Name="Mid" Grid.Column="1" Text="15" MaxLength="3" TextAlignment="Right" Padding="8,6" />
        <Button Grid.Column="2" Content="?" Padding="0" Width="25" Height="25" Margin="7,0,0,0" x:Name="HelpMid" Tag="Controlla la luminanza del grigio al 18% nella curva HDR, non quella del bianco. Base Unreal: 15 nit. Aumentarlo può schiarire i toni intermedi; ridurlo può scurirli. Parti da 15 e cambia poco alla volta, verificando visi e ombre nella stessa scena. Intervallo: 5–100 nit. Non deriva dal picco del monitor e alcuni giochi ignorano questo parametro." ToolTip="Spiegazione e valori consigliati" />
       </Grid>
       <Grid Margin="0,5">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*" />
         <ColumnDefinition Width="82" />
         <ColumnDefinition Width="32" />
        </Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="Luminosità interfaccia" />
         <TextBlock Text="Base: 100%" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />
        </StackPanel>
        <TextBox x:Name="Ui" Grid.Column="1" Text="100" MaxLength="3" TextAlignment="Right" Padding="8,6" />
        <Button Grid.Column="2" Content="?" Padding="0" Width="25" Height="25" Margin="7,0,0,0" x:Name="HelpUi" Tag="Regola il moltiplicatore della luminosità dell'interfaccia quando il gioco usa la composizione UI HDR di Unreal. 100% significa moltiplicatore 1, non 100 nit. Riduci se menu e HUD abbagliano; aumenta se sono poco leggibili. Intervallo: 25–300%. Può non agire su elementi disegnati direttamente nella scena o gestiti diversamente dal gioco." ToolTip="Spiegazione e valori consigliati" />
       </Grid>
       <DockPanel Margin="0,10,0,5">
        <Button x:Name="HelpBlack" Content="?" DockPanel.Dock="Right" Padding="0" Width="25" Height="25" Tag="Il nero fisico di un OLED può essere zero. Questo controllo agisce invece sul minimo logaritmico della curva Unreal: Base = 0,0001 nit (−4); Quasi zero = 0,000001 nit (−6). Scrivere 0 nella variabile logaritmica significherebbe 1 nit. Parti dalla base: quasi zero non corregge necessariamente neri sollevati dal gioco. Conserva valore attuale mantiene un'impostazione personalizzata già presente." />
        <TextBlock Text="Punto di nero" VerticalAlignment="Center" />
       </DockPanel>
       <ComboBox x:Name="Black">
        <ComboBoxItem Content="Base Unreal · consigliato" />
        <ComboBoxItem Content="OLED · quasi zero" />
        <ComboBoxItem Content="Personalizzato · conserva valore attuale" />
       </ComboBox>
       <StackPanel x:Name="AdvancedExpander" Margin="0,14,0,8"><TextBlock Text="HDR avanzato" Foreground="#E6AC50" FontSize="14" Margin="0,8,0,8" />
        <StackPanel Margin="0,10,0,0">
         <CheckBox x:Name="UseAdvanced" Content="Applica anche questi parametri" />
         <TextBlock Text="Consiglio iniziale: conserva i valori del gioco. Quando deselezionato, i parametri esistenti restano invariati. Disponibilità ed effetto dipendono dalla versione Unreal e dal gioco." TextWrapping="Wrap" FontSize="12" Foreground="#ADBACA" Margin="0,8,0,12" />
         <StackPanel x:Name="AdvancedPanel" IsEnabled="False">
          <TextBlock Text="Formato e spazio colore" Margin="0,4,0,4" FontSize="12" />
          <Grid Margin="0,5">
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="84" />
            <ColumnDefinition Width="32" />
           </Grid.ColumnDefinitions>
           <ComboBox x:Name="OutputFormat" Margin="0,0,0,0" Grid.ColumnSpan="2">
            <ComboBoxItem Content="scRGB · curva 1000 · Rec.709" />
            <ComboBoxItem Content="scRGB · curva 2000 · Rec.709" />
            <ComboBoxItem Content="HDR10 PQ · curva 1000 · Rec.2020" />
            <ComboBoxItem Content="HDR10 PQ · curva 2000 · Rec.2020" />
           </ComboBox>
           <Button Grid.Column="2" Content="?" Padding="0" Width="25" Height="25" Margin="7,0,0,0" x:Name="HelpOutputFormat" Tag="Base: scRGB/1000. Le curve 1000 e 2000 sono preset del motore; non sostituiscono il picco personalizzato. Lo spazio colore segue il formato, non la copertura dichiarata del monitor." />
          </Grid>
          <Grid Margin="0,5">
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="84" />
            <ColumnDefinition Width="32" />
           </Grid.ColumnDefinitions>
           <TextBlock Text="Luminanza base interfaccia · nit" Margin="0" FontSize="12" VerticalAlignment="Center" />
           <TextBox x:Name="UiNits" Text="300" MaxLength="4" Margin="0" Grid.Column="1" Padding="8,6" TextAlignment="Right" />
           <Button Grid.Column="2" Content="?" Padding="0" Width="25" Height="25" Margin="7,0,0,0" x:Name="HelpUiNits" Tag="Base Unreal: 300 nit. Moltiplicata per la percentuale UI: 300 × 50% = 150 nit. Range app: 50–1000. Può non agire su HUD personalizzati." />
          </Grid>
          <Grid Margin="0,5">
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="84" />
            <ColumnDefinition Width="32" />
           </Grid.ColumnDefinitions>
           <TextBlock Text="Moltiplicatore scena ACES · %" Margin="0" FontSize="12" VerticalAlignment="Center" />
           <TextBox x:Name="ScenePercent" Text="150" MaxLength="3" Margin="0" Grid.Column="1" Padding="8,6" TextAlignment="Right" />
           <Button Grid.Column="2" Content="?" Padding="0" Width="25" Height="25" Margin="7,0,0,0" x:Name="HelpScenePercent" Tag="Base documentata: 150% (×1,5). Cambia il colore della scena prima della trasformazione HDR ACES; non è il picco del display. Range app: 25–300. Verifica luci e mezzi toni dopo ogni modifica." />
          </Grid>
          <Grid Margin="0,5">
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="84" />
            <ColumnDefinition Width="32" />
           </Grid.ColumnDefinitions>
           <CheckBox Margin="0,7,0,7" x:Name="GamutCompression" Content="Compressione colori ACES" Grid.ColumnSpan="2" />
           <Button Grid.Column="2" Content="?" Padding="0" Width="25" Height="25" Margin="7,0,0,0" x:Name="HelpGamutCompression" Tag="Riduce la tendenza dei blu molto luminosi a diventare viola, desaturandoli. Non è un controllo generale di saturazione." />
          </Grid>
          <Grid Margin="0,5">
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="84" />
            <ColumnDefinition Width="32" />
           </Grid.ColumnDefinitions>
           <CheckBox Margin="0,7,0,7" x:Name="UiComposite" Content="Composizione UI HDR" Grid.ColumnSpan="2" />
           <Button Grid.Column="2" Content="?" Padding="0" Width="25" Height="25" Margin="7,0,0,0" x:Name="HelpUiComposite" Tag="Il passaggio HDR migliora la fusione dell’interfaccia sulla scena. Usa Standard solo per confrontare eventuali problemi del gioco." />
          </Grid>
         </StackPanel>
        </StackPanel>
       </StackPanel>
       </StackPanel></Grid>
     </StackPanel>
     </ScrollViewer>
    </Border>
    <Grid x:Name="DlssSection" Grid.Column="1" Grid.Row="2" Background="#141A22" Margin="24,0,24,0" Visibility="Collapsed" />
   </Grid>
   <Border Grid.Row="2" Background="#11161D" BorderBrush="#303844" BorderThickness="0,1,0,0" Padding="22,6">
    <ContentControl x:Name="ActivityLogHost" />
   </Border>
   <Border Grid.Row="3" Background="#11161D" BorderBrush="#303844" BorderThickness="0,1,0,0" Padding="22,12">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
     </Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
      <TextBlock Text="GIOCO SELEZIONATO" FontSize="10" Foreground="#8F9BAB" />
      <TextBlock Text="{Binding Text,ElementName=GameTitle}" FontSize="13" FontWeight="SemiBold" Foreground="#EDF0F4" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="Overlay" Content="Apri overlay live" IsEnabled="False" Margin="10,0,0,0" Padding="18,11" MinWidth="150" />
      <Button x:Name="Apply" Content="Applica HDR" IsEnabled="False" Margin="10,0,0,0" Padding="18,11" MinWidth="150" />
      <Button x:Name="Play" Content="▶  Avvia gioco" Style="{StaticResource Primary}" IsEnabled="False" Margin="10,0,0,0" Padding="18,11" MinWidth="150" />
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Border>
</Window>
